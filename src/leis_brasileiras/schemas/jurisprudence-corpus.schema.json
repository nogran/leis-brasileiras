{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "version",
    "sources",
    "files",
    "complete"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "jurisprudence-corpus-v2"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "source",
          "coverage",
          "document_sha256",
          "observed_at",
          "complete"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "enum": [
              "stj_temas",
              "stj_sumulas",
              "stf_teses_rg",
              "stf_sumulas_vinculantes",
              "tjpe_sumulas",
              "tjmg_sumulas"
            ]
          },
          "coverage": {
            "enum": [
              "source_snapshot",
              "sample"
            ]
          },
          "document_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "observed_at": {
            "type": "string",
            "maxLength": 200000
          },
          "complete": {
            "type": "boolean"
          }
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "complete": {
      "type": "boolean"
    }
  }
}

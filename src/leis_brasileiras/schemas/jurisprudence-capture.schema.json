{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leis-brasileiras:schema:jurisprudence-capture:observed-1",
  "type": "object",
  "required": [
    "format",
    "source",
    "observed_at",
    "coverage",
    "document_sha256",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "jurisprudence-capture-v2"
    },
    "source": {
      "enum": [
        "stj_temas",
        "stj_sumulas",
        "stf_teses_rg",
        "stf_sumulas_vinculantes",
        "tjpe_sumulas",
        "tjmg_sumulas"
      ]
    },
    "observed_at": {
      "type": "string",
      "maxLength": 200000
    },
    "coverage": {
      "enum": [
        "source_snapshot",
        "sample"
      ]
    },
    "document_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "kind",
          "form",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^raw/[0-9]{3}\\.(html|json|pdf|csv)$"
          },
          "url": {
            "type": "string",
            "maxLength": 200000
          },
          "kind": {
            "enum": [
              "html",
              "json",
              "pdf",
              "csv"
            ]
          },
          "form": {
            "enum": [
              null,
              "com",
              "sem"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25165824
          }
        }
      }
    }
  }
}

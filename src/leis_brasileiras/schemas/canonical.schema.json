{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leis-brasileiras:schema:canonical:observed-1",
  "type": "object",
  "properties": {
    "format": {
      "const": "observed-law-v1"
    },
    "observation_contract": {
      "const": "source-observation-v1"
    },
    "law": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "aliases"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_url": {
          "type": "string"
        },
        "observation": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "precision": {
              "enum": [
                "day",
                "instant"
              ]
            }
          },
          "required": [
            "value",
            "precision"
          ],
          "additionalProperties": false
        },
        "basis": {
          "enum": [
            "source-html",
            "historical-clean-text"
          ]
        },
        "raw_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "parser_version": {
          "const": "observed-legislation@2"
        }
      },
      "required": [
        "source_url",
        "observation",
        "basis",
        "raw_sha256",
        "parser_version"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "parent_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "parent_id"
        ],
        "additionalProperties": false
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "parent_id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "article",
              "heading",
              "annex",
              "unclassified"
            ]
          },
          "label": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "readings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "source_order": {
                  "type": "string"
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source_text": {
                  "type": "string"
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "text_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "hierarchy": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "evidence_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "text",
                      "evidence_ids"
                    ],
                    "additionalProperties": false
                  }
                },
                "source_statements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "literal": {
                        "type": "string"
                      },
                      "evidence_id": {
                        "type": "string"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "target": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "literal",
                      "evidence_id",
                      "start",
                      "end",
                      "target"
                    ],
                    "additionalProperties": false
                  }
                },
                "dates": {
                  "type": "array",
                  "maxItems": 0
                },
                "mixed_markings": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "source_order",
                "evidence_ids",
                "source_text",
                "text",
                "text_sha256",
                "hierarchy",
                "source_statements",
                "dates",
                "mixed_markings"
              ],
              "additionalProperties": false
            }
          },
          "legal_validity": {
            "const": "unknown"
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "text_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "quality": {
            "enum": [
              "observed",
              "ambiguous"
            ]
          }
        },
        "required": [
          "id",
          "parent_id",
          "locator",
          "kind",
          "label",
          "order",
          "readings",
          "legal_validity",
          "text",
          "text_sha256",
          "quality"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "parser_version": {
          "type": "string"
        },
        "raw_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "undecoded_tail_hex": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoding": {
          "type": "string"
        },
        "decoded_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              },
              "attributes": {
                "type": "object"
              }
            },
            "required": [
              "path",
              "tag",
              "attributes"
            ],
            "additionalProperties": false
          }
        },
        "texts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "kind": {
                "enum": [
                  "content",
                  "active",
                  "comment",
                  "page_chrome"
                ]
              },
              "block": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "table": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "struck_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "path",
              "text",
              "text_sha256",
              "kind",
              "block",
              "table",
              "struck_by"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "parser_version",
        "raw_sha256",
        "undecoded_tail_hex",
        "encoding",
        "decoded_sha256",
        "elements",
        "texts"
      ],
      "additionalProperties": false
    },
    "reconciliation": {
      "type": "object",
      "properties": {
        "source_identities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "structured_identities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_identities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra_identities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_occurrences": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "unmapped_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unclassified_units": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discrepancies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preservation": {
          "enum": [
            "mapped",
            "incomplete"
          ]
        },
        "structure": {
          "const": "incomplete"
        },
        "complete": {
          "const": false
        },
        "census_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "source_identities",
        "structured_identities",
        "missing_identities",
        "extra_identities",
        "source_occurrences",
        "unmapped_evidence_ids",
        "unclassified_units",
        "discrepancies",
        "preservation",
        "structure",
        "complete",
        "census_method",
        "report_sha256"
      ],
      "additionalProperties": false
    },
    "structured_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "format",
    "observation_contract",
    "law",
    "provenance",
    "components",
    "units",
    "evidence",
    "reconciliation",
    "structured_sha256",
    "revision"
  ],
  "additionalProperties": false
}
